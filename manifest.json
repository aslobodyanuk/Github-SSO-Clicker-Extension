{
  "manifest_version": 3,
  "name": "GitHub SSO Clicker",
  "version": "1.0.0",
  "description": "Automatically clicks the Continue button on GitHub SSO authentication pages",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "github-sso-clicker@example.org"
    }
  }
}

